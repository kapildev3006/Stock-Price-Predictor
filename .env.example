# .env.example - Template for environment variables
# Copy this file to .env and replace with your actual values

# Builder.io API Key
VITE_PUBLIC_BUILDER_KEY=__BUILDER_PUBLIC_KEY__

# Custom ping message for testing
PING_MESSAGE="ping pong"

# MongoDB Configuration
# For local development: mongodb://localhost:27017/tradex
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/tradex?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/tradex

# Encryption key for API secrets (32+ character string)
# Generate a secure key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-secure-encryption-key-here

# Optional: Port configuration
# PORT=8080
